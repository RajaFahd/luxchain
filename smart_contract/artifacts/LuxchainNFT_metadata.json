		"devdoc": {
			"kind": "dev",
			"methods": {
				"addAdmin(address)": {
					"params": {
						"_admin": "Address to grant admin role"
					}
				},
				"claimProduct(uint256)": {
					"details": "Called when consumer scans QR and claims the product      Different from transfer — this is the initial claim from brand to consumer",
					"params": {
						"_tokenId": "Token ID to claim"
					},
					"returns": {
						"_0": "success  True if claim succeeded"
					}
				},
				"getAdmins()": {
					"returns": {
						"_0": "Array of admin wallet addresses"
					}
				},
				"getOwnershipHistory(uint256)": {
					"params": {
						"_tokenId": "Token ID to query"
					},
					"returns": {
						"_0": "Array of OwnershipRecord (owner, timestamp, type)"
					}
				},
				"getProduct(uint256)": {
					"params": {
						"_tokenId": "Token ID"
					},
					"returns": {
						"currentOwner": "Current owner address",
						"metadataHash": "SHA-256 hash of the product metadata",
						"mintedAt": "Timestamp when the product was minted",
						"mintedBy": "Admin address that minted the product",
						"uuid": "Product UUID"
					}
				},
				"getProductByUUID(string)": {
					"params": {
						"_uuid": "Product UUID"
					},
					"returns": {
						"currentOwner": "Current owner address",
						"metadataHash": "SHA-256 hash",
						"mintedAt": "    Mint timestamp",
						"mintedBy": "    Admin minter address",
						"tokenId": "     Token ID"
					}
				},
				"getTransferCount(uint256)": {
					"params": {
						"_tokenId": "Token ID"
					},
					"returns": {
						"_0": "Number of ownership changes"
					}
				},
				"isAdmin(address)": {
					"params": {
						"_addr": "Address to check"
					},
					"returns": {
						"_0": "True if address is admin"
					}
				},
				"mintToBlockchain(string,string)": {
					"details": "Called by API server after admin signs via MetaMask      Flow: Admin Form → API generates UUID + SHA-256 hash → MetaMask sign → this function",
					"params": {
						"_metadataHash": "SHA-256 hash dari metadata produk (nama+brand+SKU+warna+material+tahun+UUID)",
						"_uuid": "UUID v4 dari ProductItem (generated off-chain)"
					},
					"returns": {
						"_0": "tokenId     Auto-incremented token ID yang di-assign ke NFT"
					}
				},
				"removeAdmin(address)": {
					"params": {
						"_admin": "Address to revoke admin role"
					}
				},
				"totalSupply()": {
					"returns": {
						"_0": "Total token count"
					}
				},
				"transferProduct(uint256,address)": {
					"details": "Called when consumer transfers NFT (preloved/resale)      Consumer signs via MetaMask → Smart Contract executes transfer",
					"params": {
						"_to": "New owner address",
						"_tokenId": "Token ID to transfer"
					},
					"returns": {
						"_0": "success  True if transfer succeeded"
					}
				},
				"verifyProduct(uint256)": {
					"details": "Read-only function called during QR scan verification flow      The API server recomputes the hash from MySQL metadata and compares",
					"params": {
						"_tokenId": "Token ID to verify"
					},
					"returns": {
						"currentOwner": "Current owner address of the NFT",
						"metadataHash": "SHA-256 hash stored on-chain",
						"mintedAt": "    Timestamp when the product was minted",
						"mintedBy": "    Admin who originally minted this product",
						"uuid": "        UUID of the product"
					}
				}
			},
			"version": 1
		},
		"userdoc": {
			"events": {
				"AdminUpdated(address,bool,uint256)": {
					"notice": "Emitted when an admin is added or removed"
				},
				"OwnershipTransferred(uint256,address,address,string,uint256)": {
					"notice": "Emitted when product ownership is transferred"
				},
				"ProductMinted(uint256,string,string,address,uint256)": {
					"notice": "Emitted when a new product is minted to blockchain"
				},
				"ProductVerified(uint256,string,address,uint256)": {
					"notice": "Emitted when a product is verified"
				}
			},
			"kind": "user",
			"methods": {
				"addAdmin(address)": {
					"notice": "Add a new admin wallet address"
				},
				"claimProduct(uint256)": {
					"notice": "Claim ownership of a product (first buyer claiming from admin/brand)"
